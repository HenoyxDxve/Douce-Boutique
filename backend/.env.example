# Django Settings
SECRET_KEY=your-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,*

# Database (SQLite by default, change to PostgreSQL in production)
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=ecommerce
# DB_USER=postgres
# DB_PASSWORD=password
# DB_HOST=localhost
# DB_PORT=5432

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# JWT
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production

# CinetPay (carte bancaire + Mobile Money : Orange, MTN, Wave). Laisser vide pour le mode simulation.
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_NOTIFY_URL=http://localhost:8000/api/paiements/cinetpay/notify/
FRONTEND_URL=http://localhost:5173

# Firebase Cloud Messaging (notifications push, optionnel). Laisser vide pour le mode simulation.
FIREBASE_CREDENTIALS_PATH=

# Email (newsletter). Par défaut : console (aucun envoi réel). Voir README pour un vrai SMTP.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=BelleBoutique <noreply@belleboutique.ci>

# Brevo (ex-Sendinblue) — email + SMS transactionnels en production. Laisser
# vide pour le mode simulation (email → console, SMS → journalisé uniquement).
# Renseigner BREVO_SMTP_LOGIN/BREVO_SMTP_KEY bascule automatiquement l'envoi
# d'email sur le relais SMTP Brevo (remplace les réglages EMAIL_* ci-dessus).
BREVO_API_KEY=
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
BREVO_SMS_SENDER=DouceBoutik

# Connexion Google (Sign-In). Laisser vide pour désactiver le bouton.
GOOGLE_CLIENT_ID=

# Premier compte admin créé (ou promu) au déploiement. Laisser vide pour ne
# rien faire — utile uniquement sur une base fraîche sans Shell disponible.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Stockage des images produits sur Cloudflare R2 (gratuit, compatible S3).
# Laisser vide pour rester sur le disque local (dev uniquement — à éviter en
# production, le disque des services Render n'est pas persistant).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
R2_PUBLIC_URL=
